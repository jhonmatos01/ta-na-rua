NODE_ENV=production
PORT=3333
DATABASE_URL=postgresql://tanarua:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/tanarua
CORS_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
GEOCODING_PROVIDER_URL=https://nominatim.example.com/reverse
GEOCODING_PROVIDER_NAME=OpenStreetMap
GEOCODING_ATTRIBUTION_TEXT=© OpenStreetMap contributors
GEOCODING_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
GEOCODING_USER_AGENT=TaNaRua/1.0 (+https://github.com/jhonmatos01/ta-na-rua)
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=10000
GEOCODING_MIN_INTERVAL_MS=1000
GEOCODING_RATE_LIMIT_MAX=10
GEOCODING_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=ta-na-rua-api
JWT_AUDIENCE=ta-na-rua-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12

MAX_IMAGES_PER_OCCURRENCE=5
MAX_IMAGE_SIZE_MB=8
DUPLICATE_RADIUS_METERS=30
DUPLICATE_PERIOD_DAYS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MUNICIPALITY_MAX_DISTANCE_METERS=100000
EVALUATION_EDIT_WINDOW_DAYS=7
EVALUATION_NEGATIVE_THRESHOLD=0.5
EVALUATION_MIN_COUNT_FOR_CONTESTATION=3

AI_SERVICE_URL=https://ai.example.com
AI_SERVICE_SECRET=CHANGE_ME_AI_SECRET_WITH_AT_LEAST_32_CHARACTERS
AI_MODEL_NAME=external-ai-service
AI_TIMEOUT_MS=8000
AI_MAX_ATTEMPTS=2
AI_MIN_CONFIDENCE=0.75
AI_DUPLICATE_MIN_SIMILARITY=0.80

TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_SECRET_WITH_AT_LEAST_32_CHARS
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME_WHATSAPP_SECRET_WITH_AT_LEAST_32_CHARS
N8N_WEBHOOK_SECRET=CHANGE_ME_N8N_SECRET_WITH_AT_LEAST_32_CHARACTERS
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/ta-na-rua
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_MS=5000

STORAGE_PROVIDER=s3
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
STORAGE_BUCKET=CHANGE_ME_BUCKET
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_LOCAL_DIRECTORY=tmp/uploads

POSTGRES_DB=tanarua
POSTGRES_USER=tanarua
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
