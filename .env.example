NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://tanarua:change-me-local-only@localhost:5432/tanarua
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Em desenvolvimento, vazio usa o Nominatim publico com cache e no maximo 1 consulta externa/s.
# Em producao, configure uma instancia Nominatim compativel e dedicada; a API publica e bloqueada.
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_NAME=OpenStreetMap
GEOCODING_ATTRIBUTION_TEXT=© OpenStreetMap contributors
GEOCODING_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
GEOCODING_USER_AGENT=TaNaRua/1.0 (+https://github.com/jhonmatos01/ta-na-rua)
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=10000
GEOCODING_MIN_INTERVAL_MS=1000
GEOCODING_RATE_LIMIT_MAX=10
GEOCODING_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=ta-na-rua-api
JWT_AUDIENCE=ta-na-rua-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12
MAX_IMAGES_PER_OCCURRENCE=5
MAX_IMAGE_SIZE_MB=8
DUPLICATE_RADIUS_METERS=30
DUPLICATE_PERIOD_DAYS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MUNICIPALITY_MAX_DISTANCE_METERS=100000
EVALUATION_EDIT_WINDOW_DAYS=7
EVALUATION_NEGATIVE_THRESHOLD=0.5
EVALUATION_MIN_COUNT_FOR_CONTESTATION=3

# Deixe URL e segredo vazios para desabilitar a integracao no desenvolvimento local.
# O cliente envia POST para /analyze e nunca registra o segredo em logs ou no banco.
AI_SERVICE_URL=
AI_SERVICE_SECRET=
AI_MODEL_NAME=external-ai-service
AI_TIMEOUT_MS=8000
AI_MAX_ATTEMPTS=2
AI_MIN_CONFIDENCE=0.75
AI_DUPLICATE_MIN_SIMILARITY=0.80

# Use segredos diferentes, aleatorios e mantidos somente no cofre do ambiente.
# A assinatura e HMAC-SHA256 de "timestamp.corpo-bruto".
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_MS=5000

# Use local no desenvolvimento. Em producao, use s3 e preencha as credenciais no cofre do ambiente.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=tmp/uploads
STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

POSTGRES_DB=tanarua
POSTGRES_USER=tanarua
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
