meta {
  name: Refresh Session
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }
}

tests {
  test("rotaciona a sessao", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
