meta {
  name: Dashboard - Heatmap
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/dashboard/heatmap?status=PUBLISHED
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorAccessToken}}
}

tests {
  test("retorna apenas celulas geograficas agregadas", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.cellSizeMeters).to.equal(250);
    expect(res.getBody().data.cells).to.be.an("array");
  });
}
