meta {
  name: Dashboard - By Status
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/dashboard/by-status?neighborhoodId={{neighborhoodId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorAccessToken}}
}

tests {
  test("retorna status agregados", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.statuses).to.be.an("array");
  });
}
