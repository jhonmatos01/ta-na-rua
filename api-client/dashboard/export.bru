meta {
  name: Dashboard - Export CSV
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/dashboard/export?format=csv&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorAccessToken}}
}

tests {
  test("exporta CSV limitado", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("text/csv");
    expect(res.getHeader("x-export-limit")).to.equal("100");
  });
}
