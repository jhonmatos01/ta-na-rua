meta {
  name: Dashboard - Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/dashboard/summary?startDate={{dashboardStartDate}}&endDate={{dashboardEndDate}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorAccessToken}}
}

tests {
  test("retorna resumo restrito ao municipio do operador", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.summary.totalOccurrences).to.be.a("number");
    expect(res.getBody().data.filters.municipalityId).to.equal(bru.getEnvVar("municipalityId"));
  });
}
