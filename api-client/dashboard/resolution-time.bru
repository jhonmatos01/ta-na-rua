meta {
  name: Dashboard - Resolution Time
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/dashboard/resolution-time
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorAccessToken}}
}

tests {
  test("retorna distribuicao do tempo em horas", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.resolutionTime.resolvedOccurrences).to.be.a("number");
  });
}
