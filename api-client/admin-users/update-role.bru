patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  { "role": "CITIZEN" }
}

tests {
