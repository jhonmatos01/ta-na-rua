meta {
  name: Add Occurrence Image
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/occurrences/{{pendingOccurrenceId}}/images
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{citizenAccessToken}}
}

body:multipart-form {
  image: @file(../fixtures/occurrence-example.png)
}

tests {
  test("adiciona imagem pendente", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.image.moderationStatus).to.equal("PENDING");
  });
}
