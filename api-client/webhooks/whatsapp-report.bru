meta {
  name: Webhooks - WhatsApp report
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/webhooks/whatsapp/report
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const timestamp = Math.floor(Date.now() / 1000).toString();
  const eventId = `bruno-whatsapp-${timestamp}`;
  const body = JSON.stringify({
    externalEventId: eventId,
    eventType: "REPORT_RECEIVED",
    occurredAt: new Date().toISOString(),
    data: {
      municipalityId: bru.getEnvVar("municipalityId"),
      title: "Relato demonstrativo do WhatsApp",
      latitude: -12.9941,
      longitude: -38.459
    }
  });
  const signature = CryptoJS.HmacSHA256(`${timestamp}.${body}`, bru.getEnvVar("whatsappWebhookSecret")).toString(CryptoJS.enc.Hex);
  req.setHeader("content-type", "application/json");
  req.setHeader("x-webhook-id", eventId);
  req.setHeader("x-webhook-timestamp", timestamp);
  req.setHeader("x-webhook-signature", `sha256=${signature}`);
  req.setBody(body);
}

tests {
  test("aceita relato normalizado", function() {
    expect([200, 202]).to.include(res.getStatus());
  });
}
